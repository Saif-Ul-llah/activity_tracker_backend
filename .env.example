# ── Main app ──────────────────────────────────────────────
PORT=5000
APP_URL=http://localhost:5000
# Comma-separated list of allowed browser origins for CORS (leave empty to allow all in dev)
CORS_ORIGINS=

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ts_boiler_plate_mern

# ── Auth (user JWT) ───────────────────────────────────────
# Used for both signing and verifying user access tokens. Set a long random value.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Legacy alias kept for backwards compatibility; ACCESS_TOKEN_SECRET is authoritative.
JWT_SECRET=

# ── Desktop agent (device tokens) ─────────────────────────
# Separate secret for long-lived, revocable per-device tokens. MUST differ from user secrets.
DEVICE_TOKEN_SECRET=

# ── Cloudflare R2 (screenshot storage, S3-compatible) ─────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 API endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL for reading objects (custom domain or r2.dev), used by the dashboard later
R2_PUBLIC_BASE=

# ── Email (nodemailer) ────────────────────────────────────
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_TO=
